+              ;;
+            *ibus*)
+              export QT_IM_MODULE=ibus
+              export IBUS_USE_PORTAL=1
+              ;;
+          esac
+        fi
+      '
+  '';
+
+  postFixup = ''
+    # ANGLE loads libGL.so.1 and libEGL.so.1 dynamically from the GPU process.
