From 1ad1b5a7d6e8a9289fc4a2d9c576e261da8a4c30 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9=20Silva?= <andrerfosilva@gmail.com>
Date: Tue, 29 Sep 2026 12:25:37 +0100
Subject: [PATCH] mergiraf: build with -fno-strict-aliasing

---
 pkgs/by-name/me/mergiraf/package.nix | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/pkgs/by-name/me/mergiraf/package.nix b/pkgs/by-name/me/mergiraf/package.nix
index 98334b93765f9..5aaa5e5c9e96e 100644
--- a/pkgs/by-name/me/mergiraf/package.nix
+++ b/pkgs/by-name/me/mergiraf/package.nix
@@ -23,6 +23,11 @@ rustPlatform.buildRustPackage (finalAttrs: {
 
   cargoHash = "sha256-DioS90ecNOEryE7zVddu3ov2S3ylTRtLxe+Zmw2hkmM=";
 
+  # grammars generated by older tree-sitter bundle an array.h that breaks strict aliasing
+  # https://codeberg.org/mergiraf/mergiraf/issues/761
+  # https://github.com/tree-sitter/tree-sitter/commit/5177b3dc26f135d975add115ce4c6a206c5e6416
+  env.NIX_CFLAGS_COMPILE = "-fno-strict-aliasing";
+
   nativeCheckInputs = [
     git
     jujutsu
