From 938d5365ad2f35b4655cc91c60645d279fb84379 Mon Sep 17 00:00:00 2001
From: whispers <whispersofthedawn@duck.com>
Date: Sun, 26 Jul 2026 12:40:04 -0400
Subject: [PATCH 2/3] libdisplay-info_0_3: init at 0.3.0

this version was lost in upgrading libdisplay-info to 0.4.0, and causes
build failures in downstreams (particularly those still using
libdisplay-info-rs) that do not yet have support.
---
 pkgs/by-name/li/libdisplay-info/0.3.nix | 4 ++++
 pkgs/top-level/all-packages.nix         | 1 +
 2 files changed, 5 insertions(+)
 create mode 100644 pkgs/by-name/li/libdisplay-info/0.3.nix

diff --git a/pkgs/by-name/li/libdisplay-info/0.3.nix b/pkgs/by-name/li/libdisplay-info/0.3.nix
new file mode 100644
index 0000000000000..8ea9e2eab1b8d
--- /dev/null
+++ b/pkgs/by-name/li/libdisplay-info/0.3.nix
@@ -0,0 +1,4 @@
+import ./generic.nix {
+  version = "0.3.0";
+  hash = "sha256-nXf2KGovNKvcchlHlzKBkAOeySMJXgxMpbi5z9gLrdc=";
+}
diff --git a/pkgs/top-level/all-packages.nix b/pkgs/top-level/all-packages.nix
index afa90828185e3..077d1de0be293 100644
--- a/pkgs/top-level/all-packages.nix
+++ b/pkgs/top-level/all-packages.nix
@@ -5992,6 +5992,7 @@ with pkgs;
   libdbusmenu-gtk3 = libdbusmenu.override { gtkVersion = "3"; };
 
   libdisplay-info_0_2 = callPackage ../by-name/li/libdisplay-info/0.2.nix { };
+  libdisplay-info_0_3 = callPackage ../by-name/li/libdisplay-info/0.3.nix { };
 
   dwarfdump = libdwarf.bin;
 

From c088236389bd2631050f833a7c33267b48a904a6 Mon Sep 17 00:00:00 2001
From: whispers <whispersofthedawn@duck.com>
Date: Sun, 26 Jul 2026 12:40:04 -0400
Subject: [PATCH 3/3] niri: pin libdisplay-info_0_3

libdisplay-info-rs, which niri uses, does not yet support
libdisplay-info v0.4.
---
 pkgs/by-name/ni/niri/package.nix | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/pkgs/by-name/ni/niri/package.nix b/pkgs/by-name/ni/niri/package.nix
index 91ee8455fb1c2..ad8cdcf837538 100644
--- a/pkgs/by-name/ni/niri/package.nix
+++ b/pkgs/by-name/ni/niri/package.nix
@@ -4,7 +4,7 @@
   eudev,
   fetchFromGitHub,
   installShellFiles,
-  libdisplay-info,
+  libdisplay-info_0_3,
   libglvnd,
   libinput,
   libxkbcommon,
@@ -58,7 +58,7 @@ rustPlatform.buildRustPackage (finalAttrs: {
   ];
 
   buildInputs = [
-    libdisplay-info
+    libdisplay-info_0_3
     libglvnd # For libEGL
     libinput
     libxkbcommon
