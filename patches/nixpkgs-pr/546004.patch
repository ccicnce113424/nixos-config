From f73b403747d33ee5ef9bcfcca04c79d13e6126eb Mon Sep 17 00:00:00 2001
From: whispers <whispersofthedawn@duck.com>
Date: Sun, 26 Jul 2026 12:40:04 -0400
Subject: [PATCH 1/3] libdisplay-info{,_0_2}: make generic

downstreams often get behind libdisplay-info. historically,
libdisplay-info-rs has supported a maximum of 0.2 (hence the existence
of `libdisplay-info_0_2`) and now it supports a maximum of 0.3. since
there's a tendency to get behind, we rearchitect this by making the
package generic, since using `.overrideAttrs` as `libdisplay-info_0_2`
currently does is not recommended in Nixpkgs.
---
 pkgs/by-name/li/libdisplay-info/0.2.nix       |  4 ++
 pkgs/by-name/li/libdisplay-info/generic.nix   | 59 +++++++++++++++++++
 pkgs/by-name/li/libdisplay-info/package.nix   | 53 +----------------
 .../li/libdisplay-info_0_2/package.nix        | 18 ------
 pkgs/top-level/all-packages.nix               |  2 +
 5 files changed, 68 insertions(+), 68 deletions(-)
 create mode 100644 pkgs/by-name/li/libdisplay-info/0.2.nix
 create mode 100644 pkgs/by-name/li/libdisplay-info/generic.nix
 delete mode 100644 pkgs/by-name/li/libdisplay-info_0_2/package.nix

diff --git a/pkgs/by-name/li/libdisplay-info/0.2.nix b/pkgs/by-name/li/libdisplay-info/0.2.nix
new file mode 100644
index 0000000000000..75fbba07e5541
--- /dev/null
+++ b/pkgs/by-name/li/libdisplay-info/0.2.nix
@@ -0,0 +1,4 @@
+import ./generic.nix {
+  version = "0.2.0";
+  hash = "sha256-6xmWBrPHghjok43eIDGeshpUEQTuwWLXNHg7CnBUt3Q=";
+}
diff --git a/pkgs/by-name/li/libdisplay-info/generic.nix b/pkgs/by-name/li/libdisplay-info/generic.nix
new file mode 100644
index 0000000000000..17f0574c52c43
--- /dev/null
+++ b/pkgs/by-name/li/libdisplay-info/generic.nix
@@ -0,0 +1,59 @@
+{
+  version,
+  hash,
+}:
+
+{
+  lib,
+  stdenv,
+  buildPackages,
+  fetchFromGitLab,
+  meson,
+  pkg-config,
+  ninja,
+  python3,
+  hwdata,
+  v4l-utils,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "libdisplay-info";
+  inherit version;
+
+  src = fetchFromGitLab {
+    inherit hash;
+    domain = "gitlab.freedesktop.org";
+    owner = "emersion";
+    repo = "libdisplay-info";
+    tag = finalAttrs.version;
+  };
+
+  strictDeps = true;
+  __structuredAttrs = true;
+
+  depsBuildBuild = [ pkg-config ];
+  nativeBuildInputs = [
+    meson
+    pkg-config
+    ninja
+    hwdata
+    python3
+  ]
+  ++ lib.optionals (stdenv.hostPlatform.emulatorAvailable buildPackages) [
+    # Only used for tests, which we cannot run without an emulator
+    v4l-utils
+  ];
+
+  postPatch = ''
+    patchShebangs tool/gen-search-table.py
+  '';
+
+  meta = {
+    description = "EDID and DisplayID library";
+    mainProgram = "di-edid-decode";
+    homepage = "https://gitlab.freedesktop.org/emersion/libdisplay-info";
+    license = lib.licenses.mit;
+    platforms = lib.platforms.linux ++ lib.platforms.freebsd;
+    maintainers = with lib.maintainers; [ pedrohlc ];
+  };
+})
diff --git a/pkgs/by-name/li/libdisplay-info/package.nix b/pkgs/by-name/li/libdisplay-info/package.nix
