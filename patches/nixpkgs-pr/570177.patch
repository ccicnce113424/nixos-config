++static char *find_driver_data_file(const char *name)
++{
++    const char * const *data_dirs;
++    int i;
++
++    if (name == NULL) {
++        return NULL;
++    }
++
++    data_dirs = g_get_system_data_dirs();
++
++    for (i = 0; data_dirs[i] != NULL; i++) {
++        char *candidate = g_build_filename(data_dirs[i], "nvidia", name, NULL);
++
++        if (access(candidate, F_OK) != -1) {
++            return candidate;
++        }
++
++        g_free(candidate);
++    }
++
++    return NULL;
++}
++
+ static char *get_default_keys_file(const char *driver_version)
+ {
+     char *file = NULL;
+-    const char *file_noversion = "/usr/share/nvidia/nvidia-application-"
+-                                 "profiles-key-documentation";
++    char *found = NULL;
++    const char *file_noversion = "nvidia-application-profiles-key-documentation";
+ 
+     if (driver_version) {
+-        file = nvstrcat("/usr/share/nvidia/nvidia-application-profiles-",
