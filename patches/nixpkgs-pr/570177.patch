diff --git a/maintainers/scripts/nvidia-source-hashes/default.nix b/maintainers/scripts/nvidia-source-hashes/default.nix
new file mode 100644
index 0000000000000..c865e3c81bed3
--- /dev/null
+++ b/maintainers/scripts/nvidia-source-hashes/default.nix
@@ -0,0 +1,367 @@
+# Per-URL hash verification for every source fetched by
+# `pkgs.linuxPackages.nvidiaPackages.*`.
+#
+# This is the Nix side of ./verify.sh; run that script rather than this file
+# directly. The result maps "<path>-<system>-u<index>" to a fixed-output
+# derivation that downloads one URL of a source and checks it against the hash
+# nixpkgs declares.
+#
+# Nothing here knows about the NVIDIA namespace, about its component names or
+# about concrete URLs.  The namespace is walked recursively: plain attribute
+# sets are descended into (so a driver version exposed as a scope is found just
+# like any other set) and every derivation whose `.src` is a fixed-output
+# derivation carrying `urls`/`url` becomes one test per URL.  A derivation also
+# contributes the entries of its `passthru`, one level deep, which is how the
+# extra packages are exposed today; when they move into a scope instead, the
+# plain attribute set recursion picks them up.
+#
+# Each derivation is salted with `pkgs.testers.invalidateFetcherByDrvHash`, so no
+# cache or substituter can satisfy it. A previous run of this script on the same
+# machine can, so run it after each change rather than twice. That catches a
+# hash that is wrong for one of a source's URLs (GitHub vs. NVIDIA), which a
+# build of the combined derivation misses because it stops at the first working
+# URL.
+#
+# Platform specific sources (the binary driver and fabricmanager archives) are
+# read from a nixpkgs evaluation per platform, covering the 64-bit, 32-bit and
+# aarch64 hashes. The archives are platform independent, so each URL is
+# downloaded by the host's own source derivation with that platform's URL and
+# hash transplanted onto it, which needs no builder for the foreign platform. A
+# source the host itself does not have is skipped.
+#
+# Components that resolve to the same download (aliases such as `stable` and
+# `production`, the `dc` alias, a driver's bundled `lib32`) each get their own
+# check but share one derivation, so nothing is downloaded twice.
+#
+# Arguments (all optional):
+#   pkgs     nixpkgs instance used to build the checks. Defaults to this
+#            repository with `allowUnfree` and `nvidia.acceptLicense` enabled,
+#            which the unfree NVIDIA sources require.
+#   systems  Linux platforms to read platform specific sources from, as a list
+#            or a comma-separated string. Platforms a driver does not support
+#            are ignored. Defaults to x86_64-linux, i686-linux and
+#            aarch64-linux.
+#   path     comma-separated substrings a component's path must contain, e.g.
+#            "production" or "passthru.open"; empty means everything.
+#   prefetch when true, every check asks for a bogus hash instead of the
+#            declared one, so realising it always fails and reports the hash the
+#            URL actually yields. Used by ./verify.sh --prefetch to obtain new
+#            hashes; the URLs still come from nixpkgs.
+{
+  pkgs ? import ../../.. {
+    config = {
+      allowUnfree = true;
+      nvidia.acceptLicense = true;
+    };
+  },
+  systems ? null,
+  path ? "",
+  prefetch ? false,
+}:
+
+let
+  inherit (pkgs) lib;
+
+  defaultSystems = [
+    "x86_64-linux"
+    "i686-linux"
+    "aarch64-linux"
+  ];
+
+  resolvedSystems =
+    if systems == null || systems == "" then
+      defaultSystems
+    else if lib.isString systems then
+      map lib.trim (builtins.filter (s: s != "") (lib.splitString "," systems))
+    else
+      systems;
+
+  repo = ../../..;
+  config = {
+    allowUnfree = true;
+    nvidia.acceptLicense = true;
+  };
+
+  hostSystem = pkgs.stdenv.hostPlatform.system;
+
+  namespaceFor =
+    system:
+    (if system == hostSystem then pkgs else import repo { inherit system config; })
+    .linuxPackages.nvidiaPackages;
+
+  hostNamespace = namespaceFor hostSystem;
+
+  # A source the host itself cannot build, either because the branch has no
+  # archive for its platform or because the derivation refuses that platform,
+  # has no source derivation to transplant a foreign URL onto. It is skipped.
+  # `getAttrFromPath` aborts on a missing path and `tryEval` cannot catch
+  # aborts, so the presence of the path is checked first.
+  hostBuildable =
+    r:
+    let
+      probe = builtins.tryEval (
+        lib.hasAttrByPath r.path hostNamespace
+        && builtins.seq (lib.getAttrFromPath r.path hostNamespace).src true
+      );
+    in
+    probe.success && probe.value;
+
+  # A component whose `.src` is a fixed-output derivation with URLs. Anything
+  # else, such as `mod.src` (a store path) or a disabled component, is skipped.
+  isSource =
+    drv:
+    drv ? src
+    && (
+      let
+        s = drv.src;
+      in
+      lib.isDerivation s && (s ? urls || s ? url)
+    );
+
+  urlsOf = src: lib.unique (if src ? urls && src.urls != [ ] then src.urls else [ src.url ]);
+
+  # Attribute names must not contain ".", "/" or ":", which nix-instantiate
+  # would read as an attribute path and silently skip.
+  pathString = parts: lib.concatStringsSep "-" parts;
+
+  normalizeSelector = selector: builtins.replaceStrings [ "." "/" ] [ "-" "-" ] selector;
+
+  # A derivation is only touched for a platform it claims to support, since a
+  # foreign one may not evaluate. Without `meta.platforms`, the host decides.
+  available =
+    system: drv:
+    if drv ? meta && drv.meta ? platforms then
+      lib.meta.availableOn { inherit system; } drv
+    else
+      system == hostSystem;
+
+  # What one member of the namespace contributes: the sources found below it,
+  # and the paths below it that failed to evaluate.
+  empty = {
+    sources = [ ];
+    failures = [ ];
+  };
+
+  merge = a: b: {
+    sources = a.sources ++ b.sources;
+    failures = a.failures ++ b.failures;
+  };
+
+  ofSources = sources: {
+    inherit sources;
+    failures = [ ];
+  };
+
+  ofFailure = path: {
+    sources = [ ];
+    failures = [ path ];
+  };
+
+  # Recursively walk the namespace: attribute sets descend, a derivation also
+  # contributes its `passthru` one level deep. A member that fails to evaluate
+  # keeps its path, so it does not drop out of the verification. Everything the
+  # walk reads of a member is decided while the pair for it is built, so the
+  # handler covers the member and its children alike.
+  sourcesIn =
+    system: namespace:
+    let
+      walk =
+        inPassthru: path: value:
+        let
+          result =
+            if lib.isFunction value then
+              empty
+            else if lib.isDerivation value then
+              if !(available system value) then
+                empty
+              else
+                merge
+                  (ofSources [
+                    {
+                      inherit path;
+                      drv = value;
+                    }
+                  ])
+                  (
+                    if !inPassthru && value ? passthru then walk true (path ++ [ "passthru" ]) value.passthru else empty
+                  )
+            else if lib.isAttrs value then
+              lib.foldl' merge empty (lib.mapAttrsToList (name: walk inPassthru (path ++ [ name ])) value)
+            else
+              empty;
+          step = builtins.tryEval result;
+        in
+        if step.success then step.value else ofFailure path;
+    in
+    walk false [ ] namespace;
+
+  recordOf =
+    system: component:
+    let
+      inherit (component.drv) src;
+    in
+    lib.imap0 (index: url: {
+      inherit (component) path;
+      inherit system index url;
+      inherit (src)
+        hash
+        outputHash
+        outputHashAlgo
+        outputHashMode
+        ;
+      source = src;
+    }) (urlsOf src);
+
+  # The walk of every platform, kept once so the sources and the failures found
+  # below come from a single evaluation.
+  walked = lib.map (system: {
+    inherit system;
+    walked = sourcesIn system (namespaceFor system);
+  }) resolvedSystems;
+
+  components = lib.concatMap (
+    w:
+    lib.map (component: {
+      inherit (w) system;
+      inherit component;
+    }) w.walked.sources
+  ) walked;
+
+  # Reading a component's record reads its source, so a component whose source
+  # cannot be read is reported rather than skipped silently. A component this
+  # host cannot build is skipped knowingly instead, the same way the checks cut
+  # it for want of a source to transplant a URL onto, which is what
+  # `hostBuildable` decides without reading the record. The fields the checks
+  # read are forced inside the handler because the records are built lazily.
+  readOne =
+    { system, component }:
+    let
+      usable = hostBuildable {
+        inherit (component) path;
+      };
+      records = lib.optionals (usable && isSource component.drv) (recordOf system component);
+      forced = builtins.deepSeq (map (r: [
+        r.path
+        r.system
+        r.index
+        r.url
+        r.hash
+        r.outputHash
+        r.outputHashAlgo
+        r.outputHashMode
+      ]) records) records;
+      step = builtins.tryEval forced;
+    in
+    if !usable then
+      empty
+    else if step.success then
+      ofSources step.value
+    else
+      ofFailure component.path;
+
+  read = lib.foldl' merge empty (lib.map readOne components);
+
+  records = read.sources;
+
+  # A path this host does not have belongs to the platform passes, so it is not
+  # a failure here. Everything else that failed to evaluate is reported.
+  failures = lib.unique (
+    lib.filter (path: lib.hasAttrByPath path hostNamespace) (
+      lib.concatMap (w: w.walked.failures) walked ++ read.failures
+    )
+  );
+
+  # Identity of the actual download. Aliases and sources shared by several
+  # platforms have the same identity, so they resolve to one derivation.
+  fetchKey =
+    r:
+    "${r.url}\n${toString r.outputHash}\n${
+      if r.outputHashAlgo == null then "" else r.outputHashAlgo
+    }\n${toString r.outputHashMode}";
+
+  # One check per (component, URL): the same component seen again under another
+  # platform is dropped, but different components (including aliases) stay.
+  pathKey = r: "${pathString r.path}\n${fetchKey r}";
+
+  checks = lib.foldl' (
+    acc: r: if lib.any (seen: pathKey seen == pathKey r) acc then acc else acc ++ [ r ]
+  ) [ ] records;
+
+  # The host-buildable component that carries the same download, or null when
+  # the host has none.
+  representative = r: lib.findFirst (x: fetchKey x == fetchKey r && hostBuildable x) null records;
+
+  systemTag = system: lib.head (lib.splitString "-" system);
+
+  pathMatches =
+    p:
+    path == ""
+    || lib.any (selector: lib.hasInfix (normalizeSelector selector) p) (lib.splitString "," path);
+
+  # The host-buildable source derivation of a component that carries this
+  # download, with this record's URL and hash transplanted on. Prefetch swaps in
+  # a bogus hash.
+  mkTest =
+    record:
+    let
+      base = (lib.getAttrFromPath record.path hostNamespace).src;
+      name = "nvidia-source-hash-${pathString record.path}-${systemTag record.system}-u${toString record.index}";
+      hashAttrs = {
+        inherit (record) outputHashMode;
+      }
+      // (
+        if prefetch then
+          {
+            hash = lib.fakeHash;
+            outputHash = lib.fakeHash;
+            outputHashAlgo = null;
+          }
+        else
+          {
+            inherit (record)
+              hash
+              outputHash
+              outputHashAlgo
+              ;
+          }
+      );
+    in
+    pkgs.testers.invalidateFetcherByDrvHash (
+      args:
+      base.overrideAttrs (
+        _:
+        {
+          inherit (args) name;
+          urls = [ record.url ];
+        }
+        // hashAttrs
+      )
+    ) { inherit name; };
+  selected = lib.filter (r: pathMatches (pathString r.path)) checks;
+
+  # A check is only useful when some component carrying the same download can
+  # be built on this host; the rest have nothing to transplant a URL onto.
+  withHostBase = builtins.concatMap (
+    r:
+    let
+      rep = representative r;
+    in
+    lib.optional (rep != null) {
+      inherit r rep;
+    }
+  ) selected;
+in
+if failures == [ ] then
+  lib.listToAttrs (
+    map (
+      p:
+      lib.nameValuePair "${pathString p.r.path}-${systemTag p.r.system}-u${toString p.r.index}" (
+        mkTest p.rep
+      )
+    ) withHostBase
+  )
+else
+  throw ''
+    ${toString (lib.length failures)} namespace entries stayed unverified because they could not be evaluated:
+    ${lib.concatMapStrings (failure: "  ${pathString failure}\n") failures}
+  ''
diff --git a/maintainers/scripts/nvidia-source-hashes/verify.sh b/maintainers/scripts/nvidia-source-hashes/verify.sh
new file mode 100755
index 0000000000000..eba466d547650
--- /dev/null
+++ b/maintainers/scripts/nvidia-source-hashes/verify.sh
@@ -0,0 +1,307 @@
+#!/usr/bin/env nix-shell
+#!nix-shell -i bash -p jq
+
+# shellcheck shell=bash
+# Verify that every source URL fetched by `linuxPackages.nvidiaPackages.*`
+# serves the content nixpkgs declares a hash for.
+#
+# Each check downloads one URL into a freshly salted fixed-output derivation, so
+# a cache or a substituter cannot satisfy it. A previous run of this script on
+# the same machine can, so run it after each change rather than twice. Every URL
+# of a source is checked separately, since a source listing several URLs (GitHub
+# and NVIDIA) is only correct if all of them match and a normal build stops at
+# the first URL that works.
+#
+# Runs on a Linux host from anywhere inside the nixpkgs checkout. Platform
+# specific sources (the binary driver and the fabricmanager archive) are
+# evaluated for every supported platform and downloaded with the host's fetcher,
+# covering `sha256_64bit`, `sha256_32bit` and `sha256_aarch64`; use --systems to
+# restrict. Sources the host itself does not have are skipped.
+#
+# Usage: verify.sh [options]
+#
+# Options:
+#   -p, --path LIST     Comma-separated substrings a component's path must
+#                       contain, e.g. "production" or "open". Default: everything.
+#   -s, --systems LIST  Comma-separated platforms whose binary driver and
+#                       fabricmanager archives are checked, e.g. "x86_64-linux".
+#                       Unsupported platforms are ignored. Default:
+#                       x86_64-linux, i686-linux, aarch64-linux.
+#   -l, --list          Only list the checks that would run, then exit.
+#   -n, --dry-run       Like --list, but also print each hash.
+#   -P, --prefetch      Download every selected URL and print the hash it
+#                       actually yields, instead of checking the declared one.
+#                       Use when bumping a version: the printed hash is the one
+#                       to paste, taken the way nixpkgs does (unpacked for the
+#                       fetchzip sources, after postFetch for the open kernel
+#                       modules). The URLs still come from nixpkgs.
+#       --strict        Treat a 404 as a failure. By default such URLs are
+#                       listed separately and do not fail the run, because
+#                       GitHub and NVIDIA publish the same release at different
+#                       times, so one of a source's URLs can be legitimately
+#                       missing.
+#   -h, --help          Show this help.
+#
+# Examples:
+#   # everything (slow: downloads every driver from every URL)
+#   ./verify.sh
+#
+#   # only the sources that gained an NVIDIA URL
+#   ./verify.sh --path open,modprobe
+#
+#   # a single driver and only the binary driver archives
+#   ./verify.sh --path production
+#
+#   # only the 32-bit binary driver archives
+#   ./verify.sh --path legacy_390 --systems i686-linux
+#
+#   # print the hashes currently served for one driver (after a version bump)
+#   ./verify.sh --prefetch --path beta
+#
+# A failing URL is reported and the run continues, so one failure does not hide
+# the others. A 404 is listed separately and only fails with --strict, but a
+# source whose URLs all return 404 always fails since then no host has it; a
+# 503 or a 429 from rate limiting counts as a failure. Exit status is 0 when
+# every selected URL matched its declared hash, 1 when at least one did not, and
+# 130 when interrupted with Ctrl+C. In --prefetch mode it is 0 once every
+# selected URL either yielded a hash or returned 404, and 1 if some URL failed
+# for another reason.
+
+set -o errexit -o nounset -o pipefail
+
+script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+nix_file="$script_dir/default.nix"
+
+path=""
+systems=""
+mode="run"
+strict=""
+
+usage() {
+    awk 'NR > 2 && !/^[[:space:]]*$/ { if (/^#/) print; else exit }' "$0" |
+        sed -e 's/^# \{0,1\}//' |
+        grep -v '^shellcheck ' || true
+}
+
+die() {
+    echo >&2 "error: $*"
+    echo >&2
+    usage >&2
+    exit 1
+}
+
+while (( $# > 0 )); do
+    case "$1" in
+        -p|--path) path=${2:?"--path requires an argument"}; shift 2 ;;
+        -s|--systems) systems=${2:?"--systems requires an argument"}; shift 2 ;;
+        -l|--list) mode=list; shift ;;
+        -n|--dry-run) mode=dry-run; shift ;;
+        -P|--prefetch) mode=prefetch; shift ;;
+        --strict) strict=1; shift ;;
+        -h|--help) usage; exit 0 ;;
+        --) shift; break ;;
+        -*) die "unknown option '$1'" ;;
+        *) die "unexpected argument '$1'" ;;
+    esac
+done
+
+tmp=$(mktemp -d)
+cleanup() {
+    set +o errexit
+    rm -rf "$tmp"
+}
+trap cleanup EXIT
+
+# A single Ctrl+C stops the run. Without this, the signal also reaches the
+# nix-store build, whose death looks like a failed check and the loop continues.
+interrupted() {
+    printf '\nInterrupted.\n' >&2
+    exit 130
+}
+trap interrupted INT
+
+# A source whose URLs all return 404 fails in both modes; one missing URL can
+# be a host that has not published a release yet.
+dead_components() {
+    local keys=("$@")
+    local comp
+    local here all
+    for comp in $(printf '%s\n' "${keys[@]}" | sed 's/-u[0-9]*$//' | sort -u); do
+        here=$(printf '%s\n' "${keys[@]}" | sed 's/-u[0-9]*$//' | grep -cx -- "$comp")
+        all=$(jq -r --arg prefix "$comp-" '[keys[] | select(startswith($prefix))] | length' "$tmp/meta.json")
+        if [[ "$here" == "$all" ]]; then
+            printf '%s\n' "$comp"
+        fi
+    done
+}
+
+# Both helpers take the same arguments; `pkgs` is left to default.nix so that
+# this repository's nixpkgs is always the one being inspected.
+cat > "$tmp/meta.nix" <<'EOF'
+{ nixFile, systems ? "", path ? "", prefetch ? false }:
+let
+  tests = import nixFile { inherit systems path prefetch; };
+in
+builtins.mapAttrs (key: drv: {
+  inherit key;
+  inherit (drv) name drvPath;
+  hash = drv.hash or "";
+  urls = drv.urls or [ ];
+}) tests
+EOF
+
+cat > "$tmp/drvs.nix" <<'EOF'
+{ nixFile, systems ? "", path ? "", prefetch ? false }:
+import nixFile { inherit systems path prefetch; }
+EOF
+
+if [[ "$mode" == prefetch ]]; then
+    prefetch_arg=true
+else
+    prefetch_arg=false
+fi
+
+filter_args=(
+    --argstr nixFile "$nix_file"
+    --argstr systems "$systems"
+    --argstr path "$path"
+    --arg prefetch "$prefetch_arg"
+)
+
+echo >&2 "Evaluating linuxPackages.nvidiaPackages sources.."
+nix-instantiate --eval --strict --json "${filter_args[@]}" "$tmp/meta.nix" > "$tmp/meta.json"
+
+total=$(jq 'length' "$tmp/meta.json")
+if (( total == 0 )); then
+    echo "No source URL matched the given filters. Check --path and --systems against the component names in pkgs/os-specific/linux/nvidia-x11/README.md." >&2
+    exit 1
+fi
+
+case "$mode" in
+    list|dry-run)
+        if [[ "$mode" == dry-run ]]; then
+            jq -r 'to_entries[] | "\(.key)\n    url:  \(.value.urls[0])\n    hash: \(.value.hash)"' "$tmp/meta.json"
+        else
+            jq -r 'to_entries[] | "\(.key)\n    \(.value.urls[0])"' "$tmp/meta.json"
+        fi
+        echo "$total check(s) selected." >&2
+        exit 0
+        ;;
+esac
+
+# Instantiate once so every derivation is on disk, then realise each one
+# individually to get per-URL results without re-evaluating nixpkgs.
+if ! nix-instantiate "${filter_args[@]}" "$tmp/drvs.nix" > /dev/null 2> "$tmp/instantiate.err"; then
+    echo >&2 "error: failed to instantiate the selected derivations:"
+    cat >&2 "$tmp/instantiate.err"
+    exit 1
+fi
+
+if [[ "$mode" == prefetch ]]; then
+    ok=0
+    bad=0
+    unavailable=0
+    unavailable_keys=()
+    while IFS=$'\t' read -r key drv_path url; do
+        log="$tmp/log"
+        if nix-store --realise "$drv_path" > /dev/null 2> "$log"; then
+            bad=$((bad + 1))
+            printf '%s\n    %s\n    ERROR: unexpectedly matched the bogus hash\n' "$key" "$url" >&2
+            continue
+        fi
+        got=$(sed -n 's/^ *got: *//p' "$log" | head -n 1)
+        if [[ -n "$got" ]]; then
+            ok=$((ok + 1))
+            printf '%s\n    %s\n    -> %s\n' "$key" "$url" "$got"
+        elif grep -qE "returned error: 404" "$log"; then
+            unavailable=$((unavailable + 1))
+            unavailable_keys+=("$key")
+            printf '%s\n    %s\n    URL NOT AVAILABLE\n' "$key" "$url" >&2
+        else
+            bad=$((bad + 1))
+            printf '%s\n    %s\n    ERROR\n' "$key" "$url" >&2
+            grep -E "curl:|error:" "$log" | head -n 3 | sed 's/^ */    /' >&2 || true
+        fi
+    done < <(jq -r 'to_entries[] | [.key, .value.drvPath, (.value.urls[0] // "")] | @tsv' "$tmp/meta.json")
+    declare -a dead=()
+    if (( unavailable > 0 )); then
+        mapfile -t dead < <(dead_components "${unavailable_keys[@]}")
+    fi
+
+    printf '\n%d hash(es) obtained' "$ok"
+    if (( unavailable > 0 )); then
+        printf ', %d URL(s) not published: %s' "$unavailable" "${unavailable_keys[*]}"
+    fi
+    if (( ${#dead[@]} > 0 )); then
+        printf ', no URL published for: %s' "${dead[*]}"
+    fi
+    if (( bad > 0 )); then
+        printf ', %d failed\n' "$bad"
+        exit 1
+    fi
+    printf '.\n'
+    if (( strict && unavailable > 0 )) || (( ${#dead[@]} > 0 )); then
+        exit 1
+    fi
+    exit 0
+fi
+
+pass=0
+fail=0
+unavailable=0
+declare -a failures=()
+declare -a unavailable_keys=()
+n=0
+
+while IFS=$'\t' read -r key drv_path hash url; do
+    n=$((n + 1))
+    printf '\n[%d/%d] %s\n    %s\n' "$n" "$total" "$key" "$url"
+
+    log="$tmp/log"
+    if nix-store --realise "$drv_path" > /dev/null 2> "$log"; then
+        pass=$((pass + 1))
+        printf '    hash ok: %s\n' "$hash"
+        continue
+    fi
+
+    if grep -q "hash mismatch in fixed-output derivation" "$log"; then
+        fail=$((fail + 1))
+        failures+=("$key")
+        printf '    \033[31mHASH MISMATCH\033[0m\n'
+        printf '    expected: %s\n' "$hash"
+        sed -n 's/^ *got: */    got:      /p' "$log"
+    elif grep -qE "returned error: 404" "$log"; then
+        unavailable=$((unavailable + 1))
+        unavailable_keys+=("$key")
+        printf '    \033[33mURL NOT AVAILABLE\033[0m\n'
+        grep -E "returned error: 404" "$log" | sed 's/^ */    /'
+    else
+        fail=$((fail + 1))
+        failures+=("$key")
+        printf '    \033[31mFAILED\033[0m\n'
+        grep -E "curl:|error:" "$log" | head -n 3 | sed 's/^ */    /' || true
+    fi
+done < <(jq -r 'to_entries[] | [.key, .value.drvPath, .value.hash, (.value.urls[0] // "")] | @tsv' "$tmp/meta.json")
+
+declare -a dead=()
+if (( unavailable > 0 )); then
+    mapfile -t dead < <(dead_components "${unavailable_keys[@]}")
+fi
+
+printf '\n%d/%d URL(s) matched their declared hash' "$pass" "$total"
+if (( unavailable > 0 )); then
+    printf ', %d URL(s) not published: %s' "$unavailable" "${unavailable_keys[*]}"
+fi
+if (( ${#dead[@]} > 0 )); then
+    printf ', no URL published for: %s' "${dead[*]}"
+fi
+if (( fail > 0 )); then
+    printf ', %d failed: %s' "$fail" "${failures[*]}"
+fi
+printf '.\n'
+if (( unavailable > 0 && !strict && ${#dead[@]} == 0 )); then
+    echo >&2 "A URL that returns 404 is not a hash mismatch; pass --strict to fail on it."
+fi
+if (( fail > 0 || ${#dead[@]} > 0 || (strict && unavailable > 0) )); then
+    exit 1
+fi

From 2456e3cd66a826e2dbaa79849ecf665fb3cf69ac Mon Sep 17 00:00:00 2001
From: ccicnce113424 <ccicnce113424@gmail.com>
Date: Fri, 2 Oct 2026 23:42:50 +0800
Subject: [PATCH 02/12] nvidia-x11: check the version of the fetched sources

A version bump whose hash was not updated silently reuses the old source from
the store, which a second URL and a postFetch make more likely. Each component
checks the version it actually built:

- nvidia-settings and nvidia-persistenced use versionCheckHook on their
  --version output; nvidia-modprobe gets the same when it moves into the
  namespace.
- The open and the non-open kernel modules read MODULE_VERSION back with modinfo
  in installCheckPhase.
- The driver has no executable that reports its version without a loaded driver,
  so it checks that a library in its output is named after the version.
- libXNVCtrl has no version in its output and no program to run, so its
  checkPhase compares NVIDIA_VERSION in the source version.mk with the version it
  is built as.

Assisted-by: omp:DeepSeek V4.1 Flash
---
 pkgs/os-specific/linux/nvidia-x11/generic.nix | 16 +++++++++++++
 .../linux/nvidia-x11/kernel-modules.nix       | 23 +++++++++++++++++++
 .../linux/nvidia-x11/persistenced.nix         |  5 ++++
 .../os-specific/linux/nvidia-x11/settings.nix | 18 +++++++++++++++
 4 files changed, 62 insertions(+)

diff --git a/pkgs/os-specific/linux/nvidia-x11/generic.nix b/pkgs/os-specific/linux/nvidia-x11/generic.nix
index e6c1595ae572d..4f33a254d03d5 100644
--- a/pkgs/os-specific/linux/nvidia-x11/generic.nix
+++ b/pkgs/os-specific/linux/nvidia-x11/generic.nix
@@ -201,6 +201,22 @@ stdenv.mkDerivation (finalAttrs: {
   ++ lib.optional (!libsOnly && firmware) "firmware";
   outputDev = if libsOnly then null else "bin";
 
+  # None of the packaged executables reports the driver version without a
+  # loaded driver, so check the unpacked driver itself: its libraries are named
+  # after the version.  This catches an archive whose hash was not updated on a
+  # version bump and which would otherwise be silently reused from the store.
+  # stdenv sets nullglob, so the glob is counted instead of listed.
+  doInstallCheck = true;
+  installCheckPhase = ''
+    runHook preInstallCheck
+    if ! { set -- "$out"/lib/*.so."$version"; [ $# -gt 0 ]; }; then
+      echo "no library is named after version $version, the driver archive is not the expected version:" >&2
+      ls "$out/lib" >&2 || true
+      exit 1
+    fi
+    runHook postInstallCheck
+  '';
+
   dontStrip = true;
   dontPatchELF = true;
 
diff --git a/pkgs/os-specific/linux/nvidia-x11/kernel-modules.nix b/pkgs/os-specific/linux/nvidia-x11/kernel-modules.nix
index 9e6998017f87e..0d1e2be113cd2 100644
--- a/pkgs/os-specific/linux/nvidia-x11/kernel-modules.nix
+++ b/pkgs/os-specific/linux/nvidia-x11/kernel-modules.nix
@@ -9,6 +9,7 @@
   patches,
   broken,
   hash ? null,
+  kmod,
 }:
 
 assert open -> hash != null;
@@ -50,6 +51,28 @@ stdenv.mkDerivation {
   installTargets = [ "modules_install" ];
   enableParallelBuilding = true;
 
+  # Both variants carry MODULE_VERSION from the sources they were built from, so
+  # reading it back catches a hash left behind on a version bump, which would
+  # otherwise silently reuse the old store tree.
+  doInstallCheck = true;
+  nativeInstallCheckInputs = [ kmod ];
+  installCheckPhase = ''
+    runHook preInstallCheck
+    # The kernel also writes the module signing certificate next to the module
+    # as `nvidia.ko.cer`; it is not a module, and modinfo rejects it.
+    module=$(find "$out/lib/modules" \( -name nvidia.ko -o -name 'nvidia.ko.*' \) ! -name '*.cer' -print -quit)
+    if [ -z "$module" ]; then
+      echo "no nvidia.ko found under $out/lib/modules" >&2
+      exit 1
+    fi
+    got=$(modinfo -F version "$module")
+    if [ "$got" != "${nvidia_x11.version}" ]; then
+      echo "nvidia.ko reports version '$got', expected '${nvidia_x11.version}'" >&2
+      exit 1
+    fi
+    runHook postInstallCheck
+  '';
+
   allowedReferences = [ ];
 
   meta = {
diff --git a/pkgs/os-specific/linux/nvidia-x11/persistenced.nix b/pkgs/os-specific/linux/nvidia-x11/persistenced.nix
index 556e53f937af3..5462ee0667936 100644
--- a/pkgs/os-specific/linux/nvidia-x11/persistenced.nix
+++ b/pkgs/os-specific/linux/nvidia-x11/persistenced.nix
@@ -9,6 +9,7 @@ nvidia_x11: sha256:
   pkg-config,
   addDriverRunpath,
   libtirpc,
+  versionCheckHook,
 }:
 
 stdenv.mkDerivation {
@@ -35,6 +36,10 @@ stdenv.mkDerivation {
     addDriverRunpath
   ];
 
+  # `nvidia-persistenced --version` prints the built source's version, catching a stale hash.
+  doInstallCheck = true;
+  nativeInstallCheckInputs = [ versionCheckHook ];
+
   buildInputs = [
     libtirpc
   ];
diff --git a/pkgs/os-specific/linux/nvidia-x11/settings.nix b/pkgs/os-specific/linux/nvidia-x11/settings.nix
index e47dc3cb4e613..b07451d09e5a8 100644
--- a/pkgs/os-specific/linux/nvidia-x11/settings.nix
+++ b/pkgs/os-specific/linux/nvidia-x11/settings.nix
@@ -21,6 +21,7 @@ nvidia_x11: sha256:
   libglvnd,
   wrapGAppsHook3,
   addDriverRunpath,
+  versionCheckHook,
   withGtk2 ? false,
   withGtk3 ? true,
 }:
@@ -58,6 +59,19 @@ let
       "libXNVCtrl.so"
     ];
 
+    # The library carries no version of its own, so check version.mk in its
+    # source, catching a hash that was not bumped with the version.
+    doCheck = true;
+    checkPhase = ''
+      runHook preCheck
+      if ! grep -q "NVIDIA_VERSION = $version" $src/version.mk; then
+        echo "the source is not nvidia-settings $version:" >&2
+        grep -m1 NVIDIA_VERSION $src/version.mk >&2 || true
+        exit 1
+      fi
+      runHook postCheck
+    '';
+
     patches = [
       # Patch the Makefile to also produce a shared library.
       (
@@ -126,6 +140,10 @@ stdenv.mkDerivation {
   enableParallelBuilding = true;
   makeFlags = [ "NV_USE_BUNDLED_LIBJANSSON=0" ];
 
+  # `nvidia-settings --version` prints the built source's version, catching a stale hash.
+  doInstallCheck = true;
+  nativeInstallCheckInputs = [ versionCheckHook ];
+
   preBuild = ''
     if [ -e src/libXNVCtrl/libXNVCtrl.a ]; then
       ( cd src/libXNVCtrl

