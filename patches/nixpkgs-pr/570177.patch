From 5a32546ec56204ea69f3312e8ebf29b1b89d67ff Mon Sep 17 00:00:00 2001
From: ccicnce113424 <ccicnce113424@gmail.com>
Date: Wed, 23 Sep 2026 22:50:14 +0800
Subject: [PATCH 08/12] nvidia-settings: find the key documentation in the XDG
 data directories

The build patched the path of the application-profile key documentation into the
source, which tied the package to NixOS. The lookup now walks the XDG data
directories, so the file is found wherever the driver installs its data files,
and the module keeps linking share/nvidia into the profile, one of those
directories.
Assisted-by: omp:DeepSeek V4.1 Flash
---
 nixos/modules/hardware/video/nvidia.nix       |  5 ++
 pkgs/os-specific/linux/nvidia-x11/generic.nix |  4 +-
 .../nvidia-settings-xdg-data-dirs.patch       | 62 +++++++++++++++++++
 .../os-specific/linux/nvidia-x11/settings.nix | 18 +++---
 4 files changed, 78 insertions(+), 11 deletions(-)
 create mode 100644 pkgs/os-specific/linux/nvidia-x11/nvidia-settings-xdg-data-dirs.patch

diff --git a/nixos/modules/hardware/video/nvidia.nix b/nixos/modules/hardware/video/nvidia.nix
index f2ecd2735dda1..8db3cf632016d 100644
--- a/nixos/modules/hardware/video/nvidia.nix
+++ b/nixos/modules/hardware/video/nvidia.nix
@@ -511,6 +511,11 @@ in
               ];
             };
           environment.systemPackages = [ nvidia_x11.bin ];
+          # `nvidia-settings` looks for its application-profile key
+          # documentation in the XDG data directories, and the driver ships it
+          # under the `bin` output. Linking it here puts it in
+          # `/run/current-system/sw/share`, which is one of them.
+          environment.pathsToLink = [ "/share/nvidia" ];
         }
 
         # X11
diff --git a/pkgs/os-specific/linux/nvidia-x11/generic.nix b/pkgs/os-specific/linux/nvidia-x11/generic.nix
