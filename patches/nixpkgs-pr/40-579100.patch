From 57c7e1e074c399443d2c256a82f0c4cae5d3f959 Mon Sep 17 00:00:00 2001
From: hellodword <46193371+hellodword@users.noreply.github.com>
Date: Mon, 26 Oct 2026 06:27:08 +0000
Subject: [PATCH] virtualbox: fix Vulkan loader lookup in VBoxDxVk

---
 pkgs/applications/virtualization/virtualbox/default.nix | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/pkgs/applications/virtualization/virtualbox/default.nix b/pkgs/applications/virtualization/virtualbox/default.nix
index 43df9e9f38349..ca422a6a54ced 100644
--- a/pkgs/applications/virtualization/virtualbox/default.nix
+++ b/pkgs/applications/virtualization/virtualbox/default.nix
@@ -43,6 +43,7 @@
   xz,
   yasm,
   glslang,
+  vulkan-loader,
   wrapGAppsHook3,
   nixosTests,
   # If open-watcom-bin is not passed, VirtualBox will fall back to use
@@ -399,6 +400,12 @@ stdenv.mkDerivation (finalAttrs: {
       wrapQtApp $out/libexec/virtualbox/VirtualBoxVM
     '';
 
+  postFixup = optionalString stdenv.hostPlatform.isLinux ''
+    # VBoxDxVk loads Vulkan dynamically; add its path after RPATH shrinking.
+    patchelf --add-rpath ${lib.makeLibraryPath [ vulkan-loader ]} \
+      "$out/libexec/virtualbox/VBoxDxVk.so"
+  '';
+
   passthru = {
     inherit extensionPack; # for inclusion in profile to prevent gc
     tests = nixosTests.virtualbox;
