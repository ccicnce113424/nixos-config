From 90605af0a78294a7e7d70df00da06c9ce613f948 Mon Sep 17 00:00:00 2001
From: ccicnce113424 <ccicnce113424@gmail.com>
Date: Tue, 17 Nov 2026 16:05:44 +0800
Subject: [PATCH 3/3] libisoburn: adopt, modernize, cleanup

---
 .../li/libisoburn/no-tcltk-dd-target.patch    | 34 +++++++++++++++++
 pkgs/by-name/li/libisoburn/package.nix        | 38 +++++++++++--------
 2 files changed, 57 insertions(+), 15 deletions(-)
 create mode 100644 pkgs/by-name/li/libisoburn/no-tcltk-dd-target.patch

diff --git a/pkgs/by-name/li/libisoburn/no-tcltk-dd-target.patch b/pkgs/by-name/li/libisoburn/no-tcltk-dd-target.patch
new file mode 100644
index 00000000000000..5ed4c588a08f3d
--- /dev/null
+++ b/pkgs/by-name/li/libisoburn/no-tcltk-dd-target.patch
@@ -0,0 +1,34 @@
+--- a/Makefile.am
++++ b/Makefile.am
+@@ -181,9 +181,7 @@
+ xorriso_make_xorriso_1_SOURCES = xorriso/make_xorriso_1.c
+ 
+ # A Proof-of-concept for frontends, and xorriso-dd-target if on Linux kernel
+-bin_SCRIPTS = \
+-	frontend/xorriso-tcltk \
+-	$(XORRISO_DD_TARGET)
++bin_SCRIPTS =
+ 
+ EXTRA_SCRIPTS = xorriso-dd-target/xorriso-dd-target
+ 
+@@ -244,18 +242,14 @@
+ man_MANS = \
+ 	xorriso/xorriso.1 \
+ 	xorriso/xorrisofs.1 \
+-	xorriso/xorrecord.1 \
+-	xorriso/xorriso-tcltk.1 \
+-	$(XORRISO_DD_TARGET_MAN)
++	xorriso/xorrecord.1
+ 
+ EXTRA_MANS = xorriso-dd-target/xorriso-dd-target.1
+ 
+ info_TEXINFOS = \
+ 	xorriso/xorriso.texi \
+ 	xorriso/xorrisofs.texi \
+-	xorriso/xorrecord.texi \
+-	xorriso/xorriso-tcltk.texi \
+-	xorriso-dd-target/xorriso-dd-target.texi
++	xorriso/xorrecord.texi
+ 
+ # xorriso-dd-target.texi is hardcoded for now because of
+ #   Makefile.am: error: texinfo file '@XORRISO_DD_TARGET_TEXI@' has
diff --git a/pkgs/by-name/li/libisoburn/package.nix b/pkgs/by-name/li/libisoburn/package.nix
index 6ebf64c9e7fd8b..0d57752adae2b7 100644
--- a/pkgs/by-name/li/libisoburn/package.nix
+++ b/pkgs/by-name/li/libisoburn/package.nix
@@ -1,18 +1,17 @@
 {
   lib,
   acl,
-  attr,
   autoreconfHook,
-  bzip2,
   fetchFromGitea,
   libburn,
-  libcdio,
   libiconv,
   libisofs,
   pkg-config,
   readline,
   stdenv,
   zlib,
+  versionCheckHook,
+  nix-update-script,
 }:
 
 stdenv.mkDerivation (finalAttrs: {
@@ -23,19 +22,23 @@ stdenv.mkDerivation (finalAttrs: {
     domain = "dev.lovelyhq.com";
     owner = "libburnia";
     repo = "libisoburn";
-    rev = "release-${finalAttrs.version}";
+    tag = "release-${finalAttrs.version}";
     hash = "sha256-wYX2foI0YXrhVENz8QqfS9IdXwbsHP7rqYOWzlo8FdM=";
   };
 
+  # Drop the Tcl/Tk frontend and the xorriso-dd-target script, plus their
+  # man/info pages. The frontend needs BWidget (not provided by tk), and
+  # xorriso-dd-target hardcodes FHS paths for lsblk/dd/umount.
+  patches = [
+    ./no-tcltk-dd-target.patch
+  ];
+
   nativeBuildInputs = [
     autoreconfHook
     pkg-config
   ];
 
   buildInputs = [
-    bzip2
-    libcdio
-    libiconv
     readline
     zlib
     libburn
@@ -43,11 +46,9 @@ stdenv.mkDerivation (finalAttrs: {
   ]
   ++ lib.optionals stdenv.hostPlatform.isLinux [
     acl
-    attr
-  ];
-
-  propagatedBuildInputs = lib.optionals stdenv.hostPlatform.isLinux [
-    acl
+  ]
+  ++ lib.optionals stdenv.hostPlatform.isDarwin [
+    libiconv
   ];
 
   outputs = [
@@ -59,14 +60,21 @@ stdenv.mkDerivation (finalAttrs: {
   ];
 
   strictDeps = true;
+  __structuredAttrs = true;
+  enableParallelBuilding = true;
+
+  doInstallCheck = true;
+  nativeInstallCheckInputs = [ versionCheckHook ];
+
+  passthru.updateScript = nix-update-script { };
 
   meta = {
     homepage = "http://libburnia-project.org/";
     description = "Enables creation and expansion of ISO-9660 filesystems on CD/DVD/BD";
-    changelog = "https://dev.lovelyhq.com/libburnia/libisoburn/src/tag/${finalAttrs.src.rev}/ChangeLog";
+    changelog = "https://dev.lovelyhq.com/libburnia/libisoburn/src/tag/${finalAttrs.src.tag}/ChangeLog";
     license = lib.licenses.gpl2Plus;
-    mainProgram = "osirrox";
-    maintainers = [ ];
+    maintainers = with lib.maintainers; [ ccicnce113424 ];
+    mainProgram = "xorriso";
     inherit (libisofs.meta) platforms;
   };
 })
