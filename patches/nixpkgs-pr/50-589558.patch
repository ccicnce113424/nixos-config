From 73502ecabd06225abdefe906ebce532d1d36e692 Mon Sep 17 00:00:00 2001
From: ccicnce113424 <ccicnce113424@gmail.com>
Date: Tue, 17 Nov 2026 15:37:04 +0800
Subject: [PATCH 1/3] libisofs: adopt, modernize

---
 pkgs/by-name/li/libisofs/package.nix | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/pkgs/by-name/li/libisofs/package.nix b/pkgs/by-name/li/libisofs/package.nix
index 6ba5e4d4895310..4644a99d0a2e29 100644
--- a/pkgs/by-name/li/libisofs/package.nix
+++ b/pkgs/by-name/li/libisofs/package.nix
@@ -3,10 +3,10 @@
   stdenv,
   fetchFromGitea,
   acl,
-  attr,
   autoreconfHook,
   libiconv,
   zlib,
+  nix-update-script,
 }:
 
 stdenv.mkDerivation (finalAttrs: {
@@ -17,7 +17,7 @@ stdenv.mkDerivation (finalAttrs: {
     domain = "dev.lovelyhq.com";
     owner = "libburnia";
     repo = "libisofs";
-    rev = "release-${finalAttrs.version}";
+    tag = "release-${finalAttrs.version}";
     hash = "sha256-uyE+7H5zWcBgtOsoFtiLFroeqA0Kj7tg7s+1IzXNKBo=";
   };
 
@@ -28,7 +28,6 @@ stdenv.mkDerivation (finalAttrs: {
   buildInputs =
     lib.optionals stdenv.hostPlatform.isLinux [
       acl
-      attr
     ]
     ++ lib.optionals stdenv.hostPlatform.isDarwin [
       libiconv
@@ -42,14 +41,18 @@ stdenv.mkDerivation (finalAttrs: {
     "dev"
   ];
 
+  strictDeps = true;
+  __structuredAttrs = true;
   enableParallelBuilding = true;
 
+  passthru.updateScript = nix-update-script { };
+
   meta = {
     homepage = "https://dev.lovelyhq.com/libburnia/web/wiki";
     description = "Library to create an ISO-9660 filesystem with extensions like RockRidge or Joliet";
-    changelog = "https://dev.lovelyhq.com/libburnia/libisofs/src/tag/${finalAttrs.src.rev}/ChangeLog";
+    changelog = "https://dev.lovelyhq.com/libburnia/libisofs/src/tag/${finalAttrs.src.tag}/ChangeLog";
     license = lib.licenses.gpl2Plus;
-    maintainers = [ ];
+    maintainers = with lib.maintainers; [ ccicnce113424 ];
     platforms = lib.platforms.unix;
   };
 })

