From c93bac0ab864bfa3d83f7494255432a707ed4247 Mon Sep 17 00:00:00 2001
From: ccicnce113424 <ccicnce113424@gmail.com>
Date: Wed, 23 Sep 2026 22:50:14 +0800
Subject: [PATCH 7/7] nvidia-settings: get profiles from /run/current-system/sw

---
 pkgs/os-specific/linux/nvidia-x11/generic.nix  |  4 ++--
 pkgs/os-specific/linux/nvidia-x11/settings.nix | 12 ++++++------
 2 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/pkgs/os-specific/linux/nvidia-x11/generic.nix b/pkgs/os-specific/linux/nvidia-x11/generic.nix
index 05995804125db..c28e39a36c302 100644
--- a/pkgs/os-specific/linux/nvidia-x11/generic.nix
+++ b/pkgs/os-specific/linux/nvidia-x11/generic.nix
@@ -199,12 +199,12 @@ nvidiaDriver.overrideAttrs (
       settings =
         if useSettings then
           (if settings32Bit then pkgsi686Linux.callPackage else callPackage) ./settings.nix {
-            nvidia_x11 = finalAttrs.finalPackage;
             version = settingsVersion;
             hash = settingsSha256;
             withGtk2 = preferGtk2;
             withGtk3 = !preferGtk2;
-            inherit fetchFromGithubOrNvidia;
+            inherit fetchFromGithubOrNvidia useProfiles;
+            inherit (finalAttrs.meta) platforms;
           }
         else
           { };
diff --git a/pkgs/os-specific/linux/nvidia-x11/settings.nix b/pkgs/os-specific/linux/nvidia-x11/settings.nix
index 7b4cfbca5abbc..ecc5b8c9462f2 100644
--- a/pkgs/os-specific/linux/nvidia-x11/settings.nix
+++ b/pkgs/os-specific/linux/nvidia-x11/settings.nix
@@ -19,10 +19,11 @@
   libglvnd,
   wrapGAppsHook3,
   addDriverRunpath,
-  nvidia_x11,
-  versionCheckHook,
+  platforms,
   version,
   hash,
+  useProfiles,
+  versionCheckHook,
   withGtk2 ? false,
   withGtk3 ? true,
 }:
@@ -37,7 +38,7 @@ let
 
   meta = {
     homepage = "https://www.nvidia.com/object/unix.html";
-    platforms = nvidia_x11.meta.platforms;
+    inherit platforms;
   };
 
   libXNVCtrl = stdenv.mkDerivation {
@@ -128,8 +129,8 @@ stdenv.mkDerivation {
           hash = "sha256-wKuO5CUTUuwYvsP46Pz+6fI0yxLNpZv8qlbL0TFkEFE=";
         });
 
-  postPatch = lib.optionalString nvidia_x11.useProfiles ''
-    sed -i 's,/usr/share/nvidia/,${nvidia_x11.bin}/share/nvidia/,g' src/gtk+-2.x/ctkappprofile.c
+  postPatch = lib.optionalString useProfiles ''
+    sed -i 's,/usr/share/nvidia/,/run/current-system/sw/share/nvidia/,g' src/gtk+-2.x/ctkappprofile.c
   '';
 
   enableParallelBuilding = true;
@@ -162,7 +163,6 @@ stdenv.mkDerivation {
     libxext
     libxxf86vm
     libvdpau
-    nvidia_x11
     dbus
     vulkan-headers
   ]
