++
++/**
++ * Resolves an extension pack directory, allowing a wrapper to relocate it.
++ *
++ * The Nixpkgs build stores the extension pack in a symlink wrapper around the
++ * actual VirtualBox installation.  This lets both VBoxSVC and the helper app
++ * agree on that location instead of using the path compiled into the binaries.
++ * The override is ignored for processes that have switched from their real to
++ * their effective user ID, so a set-user-ID helper app cannot be tricked into
++ * operating outside its installation directory.
++ *
++ * @returns IPRT status code.
++ * @param   fArchTop    Whether to use RTPathAppPrivateArchTop (true) or
++ *                      RTPathAppPrivateNoArch (false) as the default.
++ * @param   pszSubDir   The subdirectory to append.
++ * @param   pszPath     Where to return the path.
++ * @param   cchPath     The size of the buffer.
++ */
++static int vboxExtPackGetDir(bool fArchTop, const char *pszSubDir, char *pszPath, size_t cchPath)
++{
++#ifndef RT_OS_WINDOWS
++    if (geteuid() == getuid())
++#endif
++    {
++        const char *pszShareDir = RTEnvGet("VBOX_NIX_APP_SHARE_DIR");
++        if (pszShareDir && *pszShareDir)
++        {
++            int vrc = RTStrCopy(pszPath, cchPath, pszShareDir);
++            if (RT_SUCCESS(vrc))
++                vrc = RTPathAppend(pszPath, cchPath, pszSubDir);
++            return vrc;
++        }
++    }
++
++    int vrc = fArchTop ? RTPathAppPrivateArchTop(pszPath, cchPath)
++                       : RTPathAppPrivateNoArch(pszPath, cchPath);
++    if (RT_SUCCESS(vrc))
++        vrc = RTPathAppend(pszPath, cchPath, pszSubDir);
++    return vrc;
++}
++
++
++/**
++ * Gets the directory where extension packs are installed.
++ *
++ * @returns IPRT status code.
++ * @param   pszPath     Where to return the path.
++ * @param   cchPath     The size of the buffer.
++ */
++int VBoxExtPackGetInstallDir(char *pszPath, size_t cchPath)
++{
++    return vboxExtPackGetDir(true /*fArchTop*/, VBOX_EXTPACK_INSTALL_DIR, pszPath, cchPath);
++}
++
++
++/**
++ * Gets the directory where extension pack certificates are installed.
++ *
++ * @returns IPRT status code.
++ * @param   pszPath     Where to return the path.
++ * @param   cchPath     The size of the buffer.
++ */
++int VBoxExtPackGetCertDir(char *pszPath, size_t cchPath)
++{
++    return vboxExtPackGetDir(false /*fArchTop*/, VBOX_EXTPACK_CERT_DIR, pszPath, cchPath);
++}
++
